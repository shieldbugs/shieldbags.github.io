rules_version = '2';

// Existing Firebase app data retained from the current project rules:
// analytics_login_events/{eventId}: create by matching signed-in UID; read by legacy admins.
// analytics_search_events/{eventId}: signed-in or anonymous create; read by legacy admins.
// admins/{uid}: owner-readable admin marker; writes remain disabled from clients.
// games/{gameId}: public read; writes by legacy admins only.
// users/{uid} and users/{uid}/gameSaves/{gameId}: owner-only read/write.
// usernames/{username}: public read; owner create; immutable after creation.
// Storefront additions:
// products/{productId}: public catalog, validated writes by storefront admins.
// siteSettings/storefront: public text/theme, validated writes by storefront admins.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Keep the original admin definition for the other apps that use this project.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    // The storefront also accepts the role marker that was created for its web admin.
    function isStoreAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('enabled', false) == true
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'admin');
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    function safeImage(value) {
      return value == null
        || (value is string
          && value.size() <= 500
          && (value.matches('^https://.*') || value.matches('^assets/.*')));
    }

    function validImageList(images) {
      return images is list
        && images.size() <= 10
        && (images.size() < 1 || safeImage(images[0]))
        && (images.size() < 2 || safeImage(images[1]))
        && (images.size() < 3 || safeImage(images[2]))
        && (images.size() < 4 || safeImage(images[3]))
        && (images.size() < 5 || safeImage(images[4]))
        && (images.size() < 6 || safeImage(images[5]))
        && (images.size() < 7 || safeImage(images[6]))
        && (images.size() < 8 || safeImage(images[7]))
        && (images.size() < 9 || safeImage(images[8]))
        && (images.size() < 10 || safeImage(images[9]));
    }

    function validProduct(data) {
      return data.keys().hasOnly(['name', 'price', 'category', 'description', 'image', 'images', 'tag'])
        && data.keys().hasAll(['name', 'price', 'category'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && (data.price == null || (data.price is number && data.price >= 0 && data.price <= 10000000))
        && data.category is string && data.category in ['مدرسي', 'ظهر', 'عروض']
        && (!('description' in data) || (data.description is string && data.description.size() <= 1500))
        && (!('tag' in data) || (data.tag is string && data.tag.size() <= 80))
        && (!('image' in data) || safeImage(data.image))
        && (!('images' in data) || validImageList(data.images));
    }

    function validSiteColor(colors, key) {
      return colors[key] is string
        && colors[key].matches('^#[A-Fa-f0-9]{6}$');
    }

    function validSiteSettings(data) {
      return data.keys().hasOnly(['textsJson', 'colors'])
        && data.keys().hasAll(['textsJson', 'colors'])
        && data.textsJson is string
        && data.textsJson.size() <= 100000
        && data.colors is map
        && data.colors.keys().hasOnly(['accent', 'primary', 'background', 'surface', 'text', 'muted', 'border'])
        && data.colors.keys().hasAll(['accent', 'primary', 'background', 'surface', 'text', 'muted', 'border'])
        && validSiteColor(data.colors, 'accent')
        && validSiteColor(data.colors, 'primary')
        && validSiteColor(data.colors, 'background')
        && validSiteColor(data.colors, 'surface')
        && validSiteColor(data.colors, 'text')
        && validSiteColor(data.colors, 'muted')
        && validSiteColor(data.colors, 'border');
    }

    // Existing analytics behavior.
    match /analytics_login_events/{eventId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /analytics_search_events/{eventId} {
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid)
        || (!signedIn() && request.resource.data.uid == null);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Existing admin marker behavior: self-read only, no client-side writes.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Existing game catalog behavior.
    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Existing player profile and game-save behavior.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /gameSaves/{gameId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Existing username lookup behavior.
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Shield Bags storefront: public product catalog, writes only by storefront admins.
    match /products/{productId} {
      allow read: if true;
      allow create: if isStoreAdmin() && uidUnchanged() && validProduct(request.resource.data);
      allow update: if isStoreAdmin() && uidNotModified() && validProduct(request.resource.data);
      allow delete: if isStoreAdmin();
    }

    // Public storefront copy/theme; only this exact document is readable by visitors.
    match /siteSettings/{settingId} {
      allow get: if settingId == 'storefront';
      allow list: if false;
      allow create: if settingId == 'storefront'
        && isStoreAdmin()
        && uidUnchanged()
        && validSiteSettings(request.resource.data);
      allow update: if settingId == 'storefront'
        && isStoreAdmin()
        && uidNotModified()
        && validSiteSettings(request.resource.data);
      allow delete: if settingId == 'storefront' && isStoreAdmin();
    }

    // Deny all paths not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
